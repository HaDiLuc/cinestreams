  "item": [
    {
      "name": "1. Authentication & Email OTP",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản (Gửi OTP 6 số qua email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nguyenvan_a\",\n  \"email\": \"dongdinhvan17031991@gmail.com\",\n  \"password\": \"123456\",\n  \"roles\": [\"user\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Đăng ký tài khoản mới. Hệ thống sẽ sinh mã xác minh 6 số ngẫu nhiên, lưu tạm thời trong 10 phút và gửi email HTML về địa chỉ email của bạn."
          }
        },
        {
          "name": "1.2 Xác minh tài khoản (Verify OTP 6 số)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dongdinhvan17031991@gmail.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify"
              ]
            },
            "description": "Nhập mã xác minh 6 chữ số nhận được trong email để kích hoạt tài khoản. Nếu quá 10 phút, tài khoản tạm thời sẽ tự động bị hủy."
          }
        },
        {
          "name": "1.3 Gửi lại mã OTP (Resend Code)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-code?email=dongdinhvan17031991@gmail.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-code"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "dongdinhvan17031991@gmail.com"
                }
              ]
            },
            "description": "Gửi lại mã OTP mới nếu chưa hết hạn hoặc mã trước đó bị thất lạc."
          }
        },
        {
          "name": "1.4 Đăng nhập Admin mẫu (Lưu Access Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "        console.log('Access token và Refresh token đã được lưu tự động!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập với tài khoản admin mặc định. Script sẽ tự động lấy accessToken và gán vào collection variable 'accessToken'."
          }
        },
        {
          "name": "1.5 Đăng nhập User vừa đăng ký",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
