# ==============================================================================
# CineStreams Monorepo .gitignore
# ==============================================================================

# ----------------- Node.js & Frontend -----------------
node_modules/
client/node_modules/
dist/
client/dist/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------- Java & Maven -----------------
target/
server/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
.flattened-pom.xml

# ----------------- CineStreams Runtime Media Uploads -----------------
# Giữ lại cấu trúc thư mục uploads nhưng không commit video và chunk tạm thời
server/uploads/temp/*
!server/uploads/temp/.gitkeep
server/uploads/videos/*
!server/uploads/videos/.gitkeep

# ----------------- Environment & Secrets -----------------
.env
.env.*
!.env.example
*.env
client/.env*
!client/.env.example
server/.env*
!server/.env.example
application-local.properties
server/src/main/resources/application-local.properties
*.pem
*.key

# ----------------- IDEs & Editors -----------------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----------------- Operating System Junk -----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
__MACOSX/
*.tmp

# ----------------- Archive Files -----------------
*.zip
*.tar.gz
*.rar
*.7z

