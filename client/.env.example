# CineStreams Frontend & Gateway Environment Configuration Template
VITE_API_BASE_URL=/api

# Google Gemini API Key for CineAI Chatbot (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Spring Boot Backend Target URL (Default: http://127.0.0.1:8088)
SPRING_BOOT_URL=http://127.0.0.1:8088

# Port for Node.js Express Gateway
PORT=3000
